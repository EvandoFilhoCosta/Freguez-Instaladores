{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freguez Caixa",
  "version": "0.7.3",
  "identifier": "br.com.freguez.caixa",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../pdv",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build --prefix ../pdv",
    "frontendDist": "../../pdv/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Freguez Caixa",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Freguez",
    "shortDescription": "Caixa do Freguez",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQjNDNERFNzY4N0UxMkQKUldRdDRZZDIzc1N6cStUT1pYSE5VWlk5Vkhxa0dvQWd6a1ZhVnBwcG5uRE5tRUtPQVRETVFxTFoK",
      "endpoints": [
        "https://pub-906d9816bb914bbfbb38fa6a0ee1bd21.r2.dev/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
